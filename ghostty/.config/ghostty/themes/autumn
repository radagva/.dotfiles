# autumn -- Ghostty
# Matches the Neovim colorscheme: https://github.com/radagv/autumn
#
# Install:
#   cp themes/autumn.conf ~/.config/ghostty/themes/autumn
# then in ~/.config/ghostty/config:
#   theme = autumn

background = #1c1815
foreground = #e8d5c4

cursor-color = #e8d5c4
cursor-text = #1c1815

selection-background = #5c4030
selection-foreground = #f5ead8

# normal
palette = 0=#2c261e
palette = 1=#d06850
palette = 2=#a8b878
palette = 3=#d8a050
palette = 4=#88a0c0
palette = 5=#e0a060
palette = 6=#78a890
palette = 7=#e8d5c4

# bright
palette = 8=#7a6850
palette = 9=#d88078
palette = 10=#b0c888
palette = 11=#e8b870
palette = 12=#a0b8d0
palette = 13=#c8a0d0
palette = 14=#90c0a8
palette = 15=#f5ead8
